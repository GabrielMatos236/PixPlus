{
  "name": "auth",
  "version": "1.0.0",
  "description": "Serviço de autenticação do Banco Pix: cadastro, login e JWT",
  "scripts": {
    "test": "node-pg-migrate up --no-verbose && node --test --test-concurrency=1",
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node-pg-migrate up --no-verbose"
  },
  "type": "module",
  "dependencies": {
    "argon2": "^0.45.1",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "supertest": "^7.3.1"
  },
  "engines": {
    "node": ">=22"
  }
}
